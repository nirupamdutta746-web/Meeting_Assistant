    {
      "parameters": {
        "jsCode": "// Parse JSON from Gemini output with safety fallbacks\nconst llmRawResponse = $json.text || $json.response || $json.output || ($input.first() ? $input.first().json.text : \"\") || \"\"; \nlet parsed;\n\ntry {\n  // Clean markdown backticks if present\n  const cleaned = llmRawResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback / error handling for invalid AI output\n  parsed = {\n    summary: llmRawResponse || \"Could not parse AI summary automatically.\",\n    decisions: [],\n    action_items: [],\n    open_questions: [\"Manual review required for transcript.\"]\n  };\n}\n\n// Ensure array fields exist even if Gemini returns missing keys\nconst summaryText = parsed.summary || \"No summary provided.\";\nconst decisionsList = Array.isArray(parsed.decisions) ? parsed.decisions : [];\nconst actionItemsList = Array.isArray(parsed.action_items) ? parsed.action_items : [];\nconst openQuestionsList = Array.isArray(parsed.open_questions) ? parsed.open_questions : [];\n\n// 1. Format the Telegram summary message\nlet telegramMessage = `📝 *Meeting Summary*\\n${summaryText}\\n\\n`;\n\nif (decisionsList.length > 0) {\n  telegramMessage += `💡 *Key Decisions:*\\n• ` + decisionsList.join('\\n• ') + `\\n\\n`;\n}\n\nif (actionItemsList.length > 0) {\n  telegramMessage += `✅ *Action Items:*\\n`;\n  actionItemsList.forEach(item => {\n    telegramMessage += `• ${item.task} (👤 ${item.owner || 'Unassigned'} | 📅 ${item.deadline || 'Not specified'})\\n`;\n  });\n  telegramMessage += `\\n`;\n}\n\nif (openQuestionsList.length > 0) {\n  telegramMessage += `❓ *Open Questions / Unassigned:*\\n• ` + openQuestionsList.join('\\n• ');\n}\n\n// 2. Prepare multiple items for Google Sheets (one row per task)\nconst outputItems = [];\n\nif (actionItemsList.length === 0) {\n  outputItems.push({\n    json: {\n      summary: summaryText,\n      task: \"No action items identified\",\n      owner: \"N/A\",\n      deadline: \"N/A\",\n      telegramSummary: telegramMessage\n    }\n  });\n} else {\n  actionItemsList.forEach(item => {\n    outputItems.push({\n      json: {\n        summary: summaryText,\n        task: item.task || \"N/A\",\n        owner: item.owner || \"Unassigned\",\n        deadline: item.deadline || \"Not specified\",\n        telegramSummary: telegramMessage\n      }\n    });\n  });\n}\n\nreturn outputItems;\nconst incompleteTasks = actionItemsList.filter(\n  item => item.owner === 'Unassigned' || item.deadline === 'Not specified'\n);\n\nif (incompleteTasks.length > 0) {\n  telegramMessage += `⚠️ *Action Required / Missing Clarifications:*\\n`;\n  incompleteTasks.forEach(item => {\n    if (item.owner === 'Unassigned' && item.deadline === 'Not specified') {\n      telegramMessage += `• *\"${item.task}\"* has no assigned owner and no deadline. Who is taking this?\\n`;\n    } else if (item.deadline === 'Not specified') {\n      telegramMessage += `• *\"${item.task}\"* (${item.owner}): Missing deadline. When will this be completed?\\n`;\n    } else if (item.owner === 'Unassigned') {\n      telegramMessage += `• *\"${item.task}\"*: Due on ${item.deadline}, but no owner is assigned.\\n`;\n    }\n  });\n  telegramMessage += `\\n`;\n}"
      },
